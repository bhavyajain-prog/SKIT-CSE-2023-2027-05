# Used by docker-compose.yml. Copy to .env and set a real password.
POSTGRES_DB=kronos
POSTGRES_USER=kronos
POSTGRES_PASSWORD=changeme
APP_PORT=3000

# Base64, at least 256 bits. Generate with: openssl rand -base64 32
JWT_SECRET=
# Optional: first SUPER_ADMIN, created on startup if this email doesn't exist yet.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
