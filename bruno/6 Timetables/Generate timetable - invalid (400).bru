meta {
  name: Generate timetable - invalid (400)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/timetables/generate
  body: json
  auth: inherit
}

body:json {
  {
    "name": "",
    "weekDays": 9,
    "maxSlots": 0
  }
}

tests {
  test("returns 400 with field errors", function () {
    expect(res.status).to.equal(400);
    expect(res.body.message).to.equal("Validation failed");
    expect(res.body.fieldErrors.length).to.equal(3);
  });
}
