meta {
  name: Get timetable
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/timetables/{{timetableId}}
  body: none
  auth: inherit
}

tests {
  test("returns the timetable", function () {
    expect(res.status).to.equal(200);
    expect(res.body.summary.id).to.equal(bru.getVar("timetableId"));
    expect(res.body.scheduled).to.be.an("array");
  });
}

docs {
  Uses `timetableId` stored by **Generate timetable**.
}
