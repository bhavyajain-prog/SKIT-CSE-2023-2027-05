meta {
  name: List timetables
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/timetables
  body: none
  auth: inherit
}

tests {
  test("returns summaries, newest first", function () {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
    if (res.body.length > 0) {
      expect(res.body[0]).to.have.property("scheduledCount");
      expect(res.body[0]).to.have.property("unscheduledCount");
    }
  });
}
