meta {
  name: Update faculty
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/api/faculty/{{facultyId}}
  body: json
  auth: inherit
}

body:json {
  {
    "firstName": "Priya",
    "lastName": "Verma",
    "email": "{{facultyEmail}}",
    "subjectIds": []
  }
}

tests {
  test("last name updated", function () {
    expect(res.status).to.equal(200);
    expect(res.body.lastName).to.equal("Verma");
  });
}
