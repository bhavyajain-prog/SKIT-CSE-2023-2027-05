meta {
  name: Login as demo user
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{demoUserEmail}}",
    "password": "{{demoUserPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("demoAccessToken", res.body.accessToken);
  }
}

tests {
  test("demo user can log in", function () {
    expect(res.status).to.equal(200);
  });
}

docs {
  Run **4 Admin / Create user** first in the same session.
}
